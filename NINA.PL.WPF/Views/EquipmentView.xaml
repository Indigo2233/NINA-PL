<UserControl x:Class="NINA.PL.WPF.Views.EquipmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1100">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,16">
            <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Eq.Title}" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.Primary}" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Content="{DynamicResource Eq.RefreshAll}" Command="{Binding RefreshAllCommand}" Style="{StaticResource AccentActionButtonStyle}" Padding="16,8"/>
        </DockPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="{DynamicResource Eq.Camera}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8,0,0">
                    <StackPanel>
                        <Border Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="3" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableCameras}" SelectedItem="{Binding SelectedCamera}"
                                          DisplayMemberPath="Name" Margin="0,0,8,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="{DynamicResource Eq.Settings}" Command="{Binding OpenCameraSettingsCommand}" Margin="0,0,8,0"/>
                                    <Button Content="{DynamicResource Eq.Refresh}" Command="{Binding RefreshCamerasCommand}" Margin="0,0,8,0"/>
                                    <Button Command="{Binding ToggleCameraConnectionCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCameraConnected}" Value="True">
                                                        <Setter Property="Content" Value="Disconnect"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsCameraConnected}" Value="False">
                                                        <Setter Property="Content" Value="Connect"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Margin="0,16,0,0" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="3" Padding="16">
                            <StackPanel>
                                <TextBlock Text="{Binding CameraStatus}" Foreground="{StaticResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                <TextBlock Text="{DynamicResource Cam.SensorColor}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Brush.Primary}" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding CameraSensorSummary}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                <TextBlock Text="{DynamicResource Cam.Formats}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Brush.Primary}" Margin="0,8,0,8"/>
                                <TextBlock Text="{Binding CameraFormatsSummary}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Camera Controls -->
                        <Border Margin="0,12,0,0" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="3" Padding="16"
                                Visibility="{Binding IsCameraConnected, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Cam.Controls}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Brush.Primary}" Margin="0,0,0,12"/>

                                <!-- Gain -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Cam.Gain}" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextSecondary}"/>
                                    <TextBox Grid.Column="1" Text="{Binding CameraGain, UpdateSourceTrigger=LostFocus}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextSecondary}" Margin="8,0" FontSize="11">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="({0:F0} – {1:F0})">
                                                <Binding Path="CameraGainMin"/>
                                                <Binding Path="CameraGainMax"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Grid>

                                <!-- Exposure -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Cam.Exposure}" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextSecondary}"/>
                                    <TextBox Grid.Column="1" Text="{Binding CameraExposureUs, UpdateSourceTrigger=LostFocus}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextSecondary}" Margin="8,0" FontSize="11">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="({0:F0} – {1:F0})">
                                                <Binding Path="CameraExposureMin"/>
                                                <Binding Path="CameraExposureMax"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Grid>

                                <!-- Binning -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Cam.Binning}" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextSecondary}"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding CameraBinOptions}"
                                              SelectedItem="{Binding CameraBinning}"/>
                                </Grid>

                                <!-- Pixel Format -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Cam.PixelFormat}" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextSecondary}"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding CameraPixelFormats}"
                                              SelectedItem="{Binding CameraSelectedPixelFormat}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource Eq.Mount}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8,0,0">
                    <StackPanel>
                        <Border Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="3" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding AvailableMounts}" SelectedItem="{Binding SelectedMount}"
                                          DisplayMemberPath="Name" Margin="0,0,8,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="{DynamicResource Eq.Settings}" Command="{Binding OpenMountSettingsCommand}" Margin="0,0,8,0"/>
                                    <Button Content="{DynamicResource Eq.Refresh}" Command="{Binding RefreshMountsCommand}" Margin="0,0,8,0"/>
                                    <Button Command="{Binding ToggleMountConnectionCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMountConnected}" Value="True">
                                                        <Setter Property="Content" Value="Disconnect"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsMountConnected}" Value="False">
                                                        <Setter Property="Content" Value="Connect"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <!-- Mount Info + Controls (horizontal layout) -->
                        <Border Margin="0,12,0,0" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="3" Padding="16"
                                Visibility="{Binding IsMountConnected, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: Coordinate Info -->
                                <StackPanel VerticalAlignment="Top">
                                    <TextBlock Text="{Binding MountStatus}" Foreground="{StaticResource Brush.TextSecondary}" FontSize="11" Margin="0,0,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Margin="0,0,12,8">
                                            <TextBlock Text="{DynamicResource Mt.RA}" FontSize="10" Foreground="{StaticResource Brush.TextSecondary}"/>
                                            <TextBlock Text="{Binding MountRightAscensionHours, StringFormat=F4}" FontSize="18" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,0,8">
                                            <TextBlock Text="{DynamicResource Mt.Dec}" FontSize="10" Foreground="{StaticResource Brush.TextSecondary}"/>
                                            <TextBlock Text="{Binding MountDeclinationDegrees, StringFormat=F4}" FontSize="18" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Margin="0,0,12,0">
                                            <TextBlock Text="{DynamicResource Mt.AltAz}" FontSize="10" Foreground="{StaticResource Brush.TextSecondary}"/>
                                            <TextBlock FontSize="14">
                                                <Run Text="{Binding MountAltitudeDegrees, StringFormat=F2}"/>
                                                <Run Text="/" Foreground="{StaticResource Brush.TextSecondary}"/>
                                                <Run Text="{Binding MountAzimuthDegrees, StringFormat=F2}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1">
                                            <TextBlock Text="{DynamicResource Mt.Tracking}" FontSize="10" Foreground="{StaticResource Brush.TextSecondary}"/>
                                            <TextBlock FontSize="14">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="OFF"/>
                                                        <Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding MountIsTracking}" Value="True">
                                                                <Setter Property="Text" Value="ON"/>
                                                                <Setter Property="Foreground" Value="{StaticResource Brush.Primary}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Tracking Rate -->
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Tracking Rate" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,8,0"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding MountTrackingRates}" SelectedItem="{Binding MountSelectedTrackingRate}"
                                                  IsEnabled="{Binding MountAtPark, Converter={StaticResource InverseBool}}"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Center: Directional Pad -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0">
                                    <TextBlock Text="{DynamicResource Mt.ManualSlew}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Brush.Primary}" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                                    <Grid HorizontalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38"/>
                                            <ColumnDefinition Width="38"/>
                                            <ColumnDefinition Width="38"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="38"/>
                                            <RowDefinition Height="38"/>
                                            <RowDefinition Height="38"/>
                                        </Grid.RowDefinitions>
                                        <Button Grid.Row="0" Grid.Column="1" Content="N" Command="{Binding MountSlewNorthCommand}" FontWeight="Bold" Margin="1" IsEnabled="{Binding MountAtPark, Converter={StaticResource InverseBool}}"/>
                                        <Button Grid.Row="1" Grid.Column="0" Content="W" Command="{Binding MountSlewWestCommand}" FontWeight="Bold" Margin="1" IsEnabled="{Binding MountAtPark, Converter={StaticResource InverseBool}}"/>
                                        <Button Grid.Row="1" Grid.Column="1" Content="■" Command="{Binding MountStopCommand}" FontSize="11" Foreground="{StaticResource Brush.Accent}" Margin="1"/>
                                        <Button Grid.Row="1" Grid.Column="2" Content="E" Command="{Binding MountSlewEastCommand}" FontWeight="Bold" Margin="1" IsEnabled="{Binding MountAtPark, Converter={StaticResource InverseBool}}"/>
                                        <Button Grid.Row="2" Grid.Column="1" Content="S" Command="{Binding MountSlewSouthCommand}" FontWeight="Bold" Margin="1" IsEnabled="{Binding MountAtPark, Converter={StaticResource InverseBool}}"/>
                                    </Grid>
                                    <ComboBox ItemsSource="{Binding MountSlewRates}" SelectedItem="{Binding MountSelectedSlewRate}" Margin="0,4,0,0" MinWidth="80" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <!-- Right: Actions -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="100">
                                    <Button Command="{Binding MountToggleParkCommand}" Padding="12,8" Margin="0,0,0,6" HorizontalAlignment="Stretch">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Content" Value="{DynamicResource Mt.Park}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MountAtPark}" Value="True">
                                                        <Setter Property="Content" Value="{DynamicResource Mt.Unpark}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="{DynamicResource Mt.Home}" Command="{Binding MountFindHomeCommand}" Padding="12,8" Margin="0,0,0,6" HorizontalAlignment="Stretch"
                                            IsEnabled="{Binding MountAtPark, Converter={StaticResource InverseBool}}"/>
                                    <ToggleButton Content="{DynamicResource Mt.Tracking}" IsChecked="{Binding MountIsTracking}" Command="{Binding MountToggleTrackingCommand}" Padding="12,8" HorizontalAlignment="Stretch"
                                                  IsEnabled="{Binding MountAtPark, Converter={StaticResource InverseBool}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource Eq.Focuser}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8,0,0">
                    <StackPanel>
                        <Border Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="3" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding AvailableFocusers}" SelectedItem="{Binding SelectedFocuser}"
                                          DisplayMemberPath="Name" Margin="0,0,8,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="{DynamicResource Eq.Settings}" Command="{Binding OpenFocuserSettingsCommand}" Margin="0,0,8,0"/>
                                    <Button Content="{DynamicResource Eq.Refresh}" Command="{Binding RefreshFocusersCommand}" Margin="0,0,8,0"/>
                                    <Button Command="{Binding ToggleFocuserConnectionCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFocuserConnected}" Value="True">
                                                        <Setter Property="Content" Value="Disconnect"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsFocuserConnected}" Value="False">
                                                        <Setter Property="Content" Value="Connect"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Margin="0,16,0,0" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="3" Padding="16">
                            <StackPanel>
                                <TextBlock Text="{Binding FocuserStatus}" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,0,12"/>
                                <UniformGrid Columns="3" Margin="0,0,0,16">
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="{DynamicResource Foc.Position}" FontSize="10" Foreground="{StaticResource Brush.TextSecondary}"/>
                                        <TextBlock FontSize="18">
                                            <Run Text="{Binding FocuserPosition}"/>
                                            <Run Text="/" Foreground="{StaticResource Brush.TextSecondary}"/>
                                            <Run Text="{Binding FocuserMaxPosition}" Foreground="{StaticResource Brush.TextSecondary}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="{DynamicResource Foc.Temperature}" FontSize="10" Foreground="{StaticResource Brush.TextSecondary}"/>
                                        <TextBlock Text="{Binding FocuserTemperature, StringFormat=F2}" FontSize="18"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Foc.Moving}" FontSize="10" Foreground="{StaticResource Brush.TextSecondary}"/>
                                        <TextBlock Text="{Binding FocuserIsMoving}" FontSize="18"/>
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock Text="{DynamicResource Foc.ManualMove}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Brush.Primary}" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Button Content="&lt;&lt;" Command="{Binding FocuserJogCommand}" CommandParameter="-500" Width="44" Margin="0,0,8,0"/>
                                    <Button Content="&lt;" Command="{Binding FocuserJogCommand}" CommandParameter="-50" Width="44" Margin="0,0,8,0"/>
                                    <Border Background="{StaticResource Brush.InputBg}" CornerRadius="3" Padding="12,8" MinWidth="72" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FocuserPosition}" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                    </Border>
                                    <Button Content="&gt;" Command="{Binding FocuserJogCommand}" CommandParameter="50" Width="44" Margin="0,0,8,0"/>
                                    <Button Content="&gt;&gt;" Command="{Binding FocuserJogCommand}" CommandParameter="500" Width="44"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Foc.Target}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource Brush.TextSecondary}"/>
                                    <TextBox Width="100" Text="{Binding FocuserTargetPosition, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                                    <Button Content="{DynamicResource Foc.Go}" Command="{Binding MoveFocuserToTargetCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource Eq.FilterWheel}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8,0,0">
                    <StackPanel>
                        <Border Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="3" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding AvailableFilterWheels}" SelectedItem="{Binding SelectedFilterWheel}"
                                          DisplayMemberPath="Name" Margin="0,0,8,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="{DynamicResource Eq.Settings}" Command="{Binding OpenFilterWheelSettingsCommand}" Margin="0,0,8,0"/>
                                    <Button Content="{DynamicResource Eq.Refresh}" Command="{Binding RefreshFilterWheelsCommand}" Margin="0,0,8,0"/>
                                    <Button Command="{Binding ToggleFilterWheelConnectionCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFilterWheelConnected}" Value="True">
                                                        <Setter Property="Content" Value="Disconnect"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsFilterWheelConnected}" Value="False">
                                                        <Setter Property="Content" Value="Connect"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Margin="0,16,0,0" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="3" Padding="16">
                            <StackPanel>
                                <TextBlock Text="{Binding FilterWheelStatus}" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,0,12"/>
                                <TextBlock Text="{DynamicResource Fw.CurrentFilter}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Brush.Primary}" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding CurrentFilterName}" FontSize="18" Margin="0,0,0,16"/>
                                <ItemsControl ItemsSource="{Binding FilterSlots}" Margin="0,4,0,0" MaxHeight="320">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,4" BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="30"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Index}" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="2" Content="{DynamicResource Fw.Select}" Padding="8,2"
                                                            Command="{Binding DataContext.SelectFilterSlotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding Index}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
